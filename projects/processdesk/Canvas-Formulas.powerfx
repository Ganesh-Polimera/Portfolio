// Implementation snippets, not an importable .msapp or canvas YAML source.
// Create controls with these exact names. Connect the SharePoint RequestIntake list.
// frmRequest: edit form, autogenerated data cards for Title, Category, Priority, BusinessNeed.
// Do not add WorkflowState as a data source to the requester app.

// frmRequest.DataSource
RequestIntake

// frmRequest.DefaultMode
FormMode.New

// btnSubmit.DisplayMode
If(frmRequest.Valid, DisplayMode.Edit, DisplayMode.Disabled)

// btnSubmit.OnSelect
If(
    frmRequest.Valid,
    SubmitForm(frmRequest),
    Notify("Complete the required fields.", NotificationType.Warning)
)

// frmRequest.OnSuccess
Set(varRequestId, frmRequest.LastSubmit.ID);
Notify("Request submitted. You will receive the approval outcome by email.", NotificationType.Success);
ResetForm(frmRequest);
NewForm(frmRequest)

// frmRequest.OnFailure
Notify("The request could not be saved. Check your connection and try again.", NotificationType.Error)

// galMyRequests.Items
// Author is SharePoint's Created By column. Validate delegation warnings in your environment.
// Filtering is a usability feature; configure server-side item access separately.
SortByColumns(
    Filter(RequestIntake, Author.Email = User().Email),
    "Created",
    SortOrder.Descending
)

// lblRequestId.Text (inside galMyRequests)
"REQ-" & Text(ThisItem.ID, "00000")

// lblSubmitted.Text (inside galMyRequests)
Text(ThisItem.Created, "mmm d, yyyy h:mm AM/PM")
